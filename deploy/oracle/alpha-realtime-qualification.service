[Unit]
Description=Wave Alpha Oracle qualification candidate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wavealpha-alpha
Group=wavealpha-alpha
WorkingDirectory=/opt/wave-alpha/alpha-realtime/current

Environment=PORT=3100
Environment=NODE_OPTIONS=--max-old-space-size=320
Environment=R2_ENDPOINT_URL=https://0f534c1b6f9bc097235b37c07d1dc32e.r2.cloudflarestorage.com
Environment=R2_BUCKET_NAME=wave-alpha-data
Environment=SUPABASE_URL=https://akbcpryqjigndzpuoany.supabase.co
Environment=WAVE_ALPHA_NODE_BIN=/opt/wave-alpha/node/current/bin/node
Environment=WAVE_ALPHA_APP_DIR=/opt/wave-alpha/alpha-realtime/current

LoadCredential=R2_READ_ONLY_ACCESS_KEY_ID:/run/wave-alpha-alpha/credentials/R2_READ_ONLY_ACCESS_KEY_ID
LoadCredential=R2_READ_ONLY_SECRET_ACCESS_KEY:/run/wave-alpha-alpha/credentials/R2_READ_ONLY_SECRET_ACCESS_KEY
LoadCredential=SUPABASE_ANON_KEY:/run/wave-alpha-alpha/credentials/SUPABASE_ANON_KEY
LoadCredential=QUALIFICATION_API_SECRET_KEY:/run/wave-alpha-alpha/credentials/QUALIFICATION_API_SECRET_KEY

ExecStart=/opt/wave-alpha/alpha-realtime/current/scripts/oracle-qualification-launch.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=384M
TasksMax=128
LimitNOFILE=4096

[Install]
# Intentionally no WantedBy target in Phase 2A. Qualification is manual-start only.
