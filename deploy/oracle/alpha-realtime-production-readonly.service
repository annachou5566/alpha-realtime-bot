[Unit]
Description=Wave Alpha Oracle Production-shaped read-only candidate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wavealpha-alpha
Group=wavealpha-alpha
WorkingDirectory=/opt/wave-alpha/alpha-realtime/current

Environment=PORT=3100
Environment=NODE_OPTIONS=--max-old-space-size=320
Environment=WAVE_RUNTIME_MODE=production-readonly
Environment=WAVE_CANONICAL_PUBLISH=off
Environment=ENABLE_TICK_CACHE=false
Environment=REALTIME_POLL_MS=300000
Environment=LIMIT_REFRESH_MS=300000
Environment=CONFIG_SYNC_MS=1800000
Environment=PRICE_SYNC_MS=900000
Environment=TOKEN_LIST_SYNC_MS=21600000
Environment=R2_ENDPOINT_URL=https://0f534c1b6f9bc097235b37c07d1dc32e.r2.cloudflarestorage.com
Environment=R2_BUCKET_NAME=wave-alpha-data
Environment=SUPABASE_URL=https://akbcpryqjigndzpuoany.supabase.co
Environment=WAVE_ALPHA_NODE_BIN=/opt/wave-alpha/node/current/bin/node
Environment=WAVE_ALPHA_APP_DIR=/opt/wave-alpha/alpha-realtime/current

LoadCredential=R2_READ_ONLY_ACCESS_KEY_ID:/run/wave-alpha-alpha/credentials/R2_READ_ONLY_ACCESS_KEY_ID
LoadCredential=R2_READ_ONLY_SECRET_ACCESS_KEY:/run/wave-alpha-alpha/credentials/R2_READ_ONLY_SECRET_ACCESS_KEY
LoadCredential=SUPABASE_ANON_KEY:/run/wave-alpha-alpha/credentials/SUPABASE_ANON_KEY
LoadCredential=PRODUCTION_READ_API_SECRET_KEY:/run/wave-alpha-alpha/credentials/PRODUCTION_READ_API_SECRET_KEY

ExecStart=/opt/wave-alpha/alpha-realtime/current/scripts/oracle-production-readonly-launch.sh
Restart=no
TimeoutStopSec=20s
KillSignal=SIGTERM

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=384M
TasksMax=128
LimitNOFILE=4096

[Install]
# Intentionally no WantedBy target in Phase 4A/4C. Manual start only.
