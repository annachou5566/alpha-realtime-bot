[Unit]
Description=Wave Alpha tails v2 canonical production writer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wavealpha-alpha
Group=wavealpha-alpha
WorkingDirectory=/opt/wave-alpha/alpha-realtime/current

Environment=NODE_OPTIONS=--max-old-space-size=256
Environment=TAILS_WRITER_MODE=production
Environment=TAILS_PRODUCTION_WRITE=true
Environment=TAILS_PRODUCTION_CONCURRENCY=2
Environment=TAILS_PRODUCTION_MAX_REQUESTS=2000
Environment=R2_ENDPOINT_URL=https://0f534c1b6f9bc097235b37c07d1dc32e.r2.cloudflarestorage.com
Environment=R2_BUCKET_NAME=wave-alpha-data
Environment=WAVE_ALPHA_NODE_BIN=/opt/wave-alpha/node/current/bin/node
Environment=WAVE_ALPHA_APP_DIR=/opt/wave-alpha/alpha-realtime/current

LoadCredential=R2_TAILS_WRITE_ACCESS_KEY_ID:/run/wave-alpha-alpha/credentials/R2_TAILS_WRITE_ACCESS_KEY_ID
LoadCredential=R2_TAILS_WRITE_SECRET_ACCESS_KEY:/run/wave-alpha-alpha/credentials/R2_TAILS_WRITE_SECRET_ACCESS_KEY

ExecStart=/usr/bin/bash /opt/wave-alpha/alpha-realtime/current/scripts/oracle-tails-production-launch.sh

TimeoutStartSec=20min
TimeoutStopSec=20s
KillSignal=SIGTERM

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TasksMax=128
LimitNOFILE=4096

[Install]
# Intentionally not enabled directly. Ownership is activated only through
# alpha-tails-production.timer after the old GitHub recurrence is OFF.
